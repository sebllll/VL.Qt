<Project>

  <!-- Files next to the exported document that VL.Qt needs at runtime and vvvv does not copy by itself (it only writes the
       paths of Path pins relative to the exe with VLAssetBehavior RelativeToOutput, #15):
         qtshaders/  shader nodes from files (#488), resolved by the node factory in the exported app, too (#506)
         fonts/      font files for the LoadFont node (#15)
       Each target copies <folder>/** next to the exported document, into the same folder name beside the exe.
       The document path comes from the exe project vvvv generates (<None Include="<document>.pc">, present even if the
       .pc does not exist): this project if it is the exe (NuGet dependency), else the exe being built, whose project
       directory is MSBuildStartupDirectory (VL.Qt.vl.csproj in the export of the repo sources, see VL.Qt.vl.targets).
       Only the folders of the exported document; those of other documents and packages are not copied. -->
  <Target Name="VLQtResolveDocument">
    <ItemGroup>
      <_VLQtExeProject Include="$(MSBuildProjectFullPath)" Condition="'$(OutputType)' != 'Library'" />
      <_VLQtExeProject Include="$(MSBuildStartupDirectory)\*.csproj" Condition="'$(OutputType)' == 'Library'" />
    </ItemGroup>
    <PropertyGroup Condition="'@(_VLQtExeProject)' != ''">
      <_VLQtDocument>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('%(_VLQtExeProject.FullPath)')), '&lt;None Include=&quot;([^&quot;]+)\.pc&quot;').Groups[1].Value)</_VLQtDocument>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_VLQtDocument)' != ''">
      <_VLQtDocumentDir>$([System.IO.Path]::GetDirectoryName('$(_VLQtDocument)'))\</_VLQtDocumentDir>
    </PropertyGroup>
  </Target>

  <Target Name="VLQtAddShaders" BeforeTargets="AssignTargetPaths" DependsOnTargets="VLQtResolveDocument">
    <PropertyGroup Condition="'$(_VLQtDocumentDir)' != ''">
      <_VLQtShadersDir>$(_VLQtDocumentDir)qtshaders\</_VLQtShadersDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(_VLQtShadersDir)' != '' And Exists('$(_VLQtShadersDir)')">
      <_VLQtShaderFile Include="$(_VLQtShadersDir)**\*" />
      <None Include="@(_VLQtShaderFile)">
        <Link>qtshaders\%(_VLQtShaderFile.RecursiveDir)%(_VLQtShaderFile.Filename)%(_VLQtShaderFile.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

  <Target Name="VLQtAddFonts" BeforeTargets="AssignTargetPaths" DependsOnTargets="VLQtResolveDocument">
    <PropertyGroup Condition="'$(_VLQtDocumentDir)' != ''">
      <_VLQtFontsDir>$(_VLQtDocumentDir)fonts\</_VLQtFontsDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(_VLQtFontsDir)' != '' And Exists('$(_VLQtFontsDir)')">
      <_VLQtFontFile Include="$(_VLQtFontsDir)**\*" />
      <None Include="@(_VLQtFontFile)">
        <Link>fonts\%(_VLQtFontFile.RecursiveDir)%(_VLQtFontFile.Filename)%(_VLQtFontFile.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

</Project>
