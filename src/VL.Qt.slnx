<Solution>
  <!-- VL.Qt first: startup project for F5 (Properties/launchSettings.json) in a fresh checkout. -->
  <Project Path="VL.Qt/VL.Qt.csproj">
    <BuildDependency Project="VL.Qt.Native/VL.Qt.Native.csproj" />
  </Project>
  <Project Path="VL.Qt.Native/VL.Qt.Native.csproj" />
  <!-- Windows only (VL.Stride); VL.Qt does not reference it. -->
  <Project Path="VL.Qt.Stride/VL.Qt.Stride.csproj" />
  <!-- Windows only (VL.Audio); VL.Qt does not reference it. -->
  <Project Path="VL.Qt.Audio/VL.Qt.Audio.csproj" />
  <Folder Name="/Solution Items/">
    <File Path="../Directory.Build.props" />
    <File Path="../README.md" />
    <File Path="../tools/build.ps1" />
    <File Path="../tools/build-native.ps1" />
    <File Path="../VL.Qt.vl.targets" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="VL.Qt.Probe/VL.Qt.Probe.csproj">
      <BuildDependency Project="VL.Qt.Native/VL.Qt.Native.csproj" />
    </Project>
    <Project Path="VL.Qt.SmokeTest/VL.Qt.SmokeTest.csproj">
      <BuildDependency Project="VL.Qt.Native/VL.Qt.Native.csproj" />
    </Project>
    <Project Path="VL.Qt.Tests/VL.Qt.Tests.csproj" />
    <!-- Windows only, like VL.Qt.Audio. -->
    <Project Path="VL.Qt.Audio.Tests/VL.Qt.Audio.Tests.csproj" />
  </Folder>
</Solution>
