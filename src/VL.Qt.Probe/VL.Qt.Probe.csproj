<Project Sdk="Microsoft.NET.Sdk">

  <!-- L3a: minimal platform-neutral console app. Loads VL.Qt.dll (project reference, internals visible) + QtNative
       from runtimes/<NativeRid>/native and shows one Qt window with a rectangle and text. Linux proof of the Qt side. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- vlqt_app_init takes a function pointer (the log callback). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeRid Condition="'$(NativeRid)' == '' And $([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</NativeRid>
    <NativeRid Condition="'$(NativeRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</NativeRid>
    <NativeRid Condition="'$(NativeRid)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</NativeRid>
    <NativeRid Condition="'$(NativeRid)' == ''">linux-x64</NativeRid>
  </PropertyGroup>

  <!-- The test exports of QtNative (vlqt_test_window_grab). -->
  <ItemGroup>
    <Compile Include="..\VL.Qt.TestSupport\NativeTest.cs" Link="NativeTest.cs" />
    <Compile Include="..\VL.Qt.TestSupport\TestProtocol.cs" Link="TestProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VL.Qt\VL.Qt.csproj" />
    <!-- VL.Qt references these privately (ExcludeAssets=runtime, vvvv provides them). The probe needs them at runtime:
         the module initializer of VL.Qt.dll (Stride serializer factory) loads VL.Core; CommandWriter has Stride overloads. -->
    <PackageReference Include="VL.Core" Version="$(VvvvVersion)" />
    <PackageReference Include="Stride.Core.Mathematics" Version="$(StrideMathematicsVersion)" />
    <None Include="..\..\runtimes\$(NativeRid)\native\**" Link="runtimes\$(NativeRid)\native\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
