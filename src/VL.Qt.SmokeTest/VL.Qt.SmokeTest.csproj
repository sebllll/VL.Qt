<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Windows: System.Drawing.Bitmap (WindowsDesktop) reads the grabs. Linux (L4a): plain net10.0, PngImage.cs reads them. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="PngImage.cs" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Compile Include="..\VL.Qt\Native.cs" Link="Native.cs" />
    <Compile Include="..\VL.Qt\Protocol.cs" Link="Protocol.cs" />
    <Compile Include="..\VL.Qt\CommandWriter.cs" Link="CommandWriter.cs" />
    <Compile Include="..\VL.Qt\Reconciler\ICommandSink.cs" Link="ICommandSink.cs" />
    <!-- Renderer core (07a): WindowRenderer + reconciler + element model. -->
    <Compile Include="..\VL.Qt\WindowRenderer.cs" Link="WindowRenderer.cs" />
    <Compile Include="..\VL.Qt\SceneCore.cs" Link="SceneCore.cs" />
    <Compile Include="..\VL.Qt\OffscreenRenderer.cs" Link="OffscreenRenderer.cs" />
    <Compile Include="..\VL.Qt\WindowPlacement.cs" Link="WindowPlacement.cs" />
    <Compile Include="..\VL.Qt\WindowSettings.cs" Link="WindowSettings.cs" />
    <Compile Include="..\VL.Qt\PerfStats.cs" Link="PerfStats.cs" />
    <Compile Include="..\VL.Qt\Geometry.cs" Link="Geometry.cs" />
    <Compile Include="..\VL.Qt\Space.cs" Link="Space.cs" />
    <Compile Include="..\VL.Qt\EventReader.cs" Link="EventReader.cs" />
    <Compile Include="..\VL.Qt\Elements\*.cs" Link="Elements\%(Filename)%(Extension)" />
    <Compile Include="..\VL.Qt\Reconciler\*.cs" Exclude="..\VL.Qt\Reconciler\ICommandSink.cs" Link="Reconciler\%(Filename)%(Extension)" />
    <Compile Include="..\VL.Qt\Styles\*.cs" Link="Styles\%(Filename)%(Extension)" />
    <Compile Include="..\VL.Qt\QtApp.cs" Link="QtApp.cs" />
    <Compile Include="..\VL.Qt\QtLog.cs" Link="QtLog.cs" />
    <Compile Include="..\VL.Qt\NodeErrors.cs" Link="NodeErrors.cs" />
    <!-- Element nodes (07d smoke: Group/Row/Column + Rectangle nodes through the real QtNative). -->
    <Compile Include="..\VL.Qt\Categories.cs" Link="Categories.cs" />
    <Compile Include="..\VL.Qt\Images\*.cs" Link="Images\%(Filename)%(Extension)" />
    <Compile Include="..\VL.Qt\Nodes\*.cs" Link="Nodes\%(Filename)%(Extension)" />
    <Compile Include="..\VL.Qt\Nodes\Interaction\*.cs" Link="Nodes\Interaction\%(Filename)%(Extension)" />
    <Compile Include="..\VL.Qt\Nodes\Effects\*.cs" Link="Nodes\Effects\%(Filename)%(Extension)" />
    <!-- QtApp (02b) + CommandWriter Stride overloads: real assemblies are copied next to the exe. -->
    <PackageReference Include="VL.Core" Version="$(VvvvVersion)" />
    <PackageReference Include="Stride.Core.Mathematics" Version="$(StrideMathematicsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(LoggingAbstractionsVersion)" />
    <PackageReference Include="System.Reactive" Version="$(SystemReactiveVersion)" />
    <None Include="..\VL.Qt.Native\protocol.h" Link="protocol.h" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\runtimes\$(RuntimeIdentifier)\native\**" Link="runtimes\$(RuntimeIdentifier)\native\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
