#!/bin/sh
# Blocks pushes to the remote named "upstream" (the public repository) if the pushed tree contains internal
# files or content (tools/check-public.py). All other remotes are not checked.
# Enable once per clone: git config core.hooksPath .githooks
[ "$1" = "upstream" ] || exit 0
root=$(git rev-parse --show-toplevel) || exit 1
py_found=
for py in python python3 py; do
    if "$py" -c "" >/dev/null 2>&1; then
        py_found=$py
        break
    fi
done
if [ -z "$py_found" ]; then
    echo "pre-push: Python not found, cannot run the public check: push to upstream blocked" >&2
    exit 1
fi
status=0
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per pushed ref
while read -r local_ref local_sha remote_ref remote_sha; do
    # A deleted ref (all-zero sha) has nothing to check.
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    echo "pre-push: checking $local_ref for upstream ..." >&2
    if ! (cd "$root" && "$py_found" -I tools/check-public.py --rev "$local_sha"); then
        echo "pre-push: $local_ref contains internal files or content, push to upstream blocked" >&2
        status=1
    fi
    # Optional: with "git config vlqt.upstreamEmail <address>", new commits must be authored and committed
    # with that address, so that no other address of the maintainer ends up in the public history.
    email=$(git config vlqt.upstreamEmail)
    [ -n "$email" ] || continue
    bad=$(git log --format='%h %ae %ce' "$local_sha" --not --remotes=upstream | awk -v e="$email" '$2 != e || $3 != e')
    if [ -n "$bad" ]; then
        echo "pre-push: $local_ref has commits not authored/committed as $email, push to upstream blocked:" >&2
        echo "$bad" >&2
        echo "pre-push: fix with: git -c user.email=$email commit --amend --reset-author (or rebase)" >&2
        status=1
    fi
done
exit $status
