          <Pad Id="qCqmbHalnV6jTNS8q7SERE" Bounds="85,85,560,98" ShowValueBox="true" isIOBox="true" Value="QML nodes from qml/*.qml: Gauge, TrendCard&#xA;- Folder qml next to this patch: one node per file (Gauge.qml gives the node Gauge, TrendCard.qml gives TrendCard)&#xA;- property = input pin, its literal value = the default (Value, Accent, Label)&#xA;- list&lt;T&gt; property = Spread pin, a literal array = the default (Points, Labels of TrendCard)&#xA;- readonly property = output (Percent), signal(int) = Spread (Milestone), signal = bang (Full)&#xA;- // lines above a declaration = pin help; @summary, @category, @tags in the file head">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
