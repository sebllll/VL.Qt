          <Pad Id="uFRlTQLkayG6RLkHnlzpUL" Bounds="223,509,240,19" ShowValueBox="true" isIOBox="true" Value="Switch to X4 or X8 and watch the edges.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
