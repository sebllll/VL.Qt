    <Node Name="Application" Bounds="100,180" Id="qBRlEaZUZrwpPtuEFBNOfQ">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="5xj7t2ydf0K5uY8iH1wOLa">
        <Canvas Id="Qan8ePsqMgLj2olXCwYjn5" CanvasType="Group">
          <Pad Id="u8jzPde0IgxLd6GncfBAep" Bounds="85,16,381,52" ShowValueBox="true" isIOBox="true" Value="How To Chain Effects">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="fJBd0Kh8oOOL8dKLzdocJ2" Bounds="85,85,830,122" ShowValueBox="true" isIOBox="true" Value="Effect nodes (Qt.Effects) chain up and attach to the Effect pin of any element:&#xD;&#xA;- Connect the Output of an effect to the Input of the next one; the last Output goes to the Effect pin.&#xD;&#xA;- The whole chain is ONE offscreen layer, no matter how many effect nodes it contains.&#xD;&#xA;- The order of the nodes does not matter.&#xD;&#xA;- Size, Transform and Interaction stay on the element, not on the effects.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="isAjIhKtJ0RlgLKOmxgJTe" Bounds="85,207,830,103" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- The same chain can feed several elements, here a Rectangle and a Text.&#xD;&#xA;- Optional pins (show them in the node): Blur Max and Multiplier, DropShadow Scale, Auto Padding and Padding on Blur and DropShadow.&#xD;&#xA;- Padding: with Auto Padding on (default) the layer grows automatically. If Auto Padding is off on any Blur or DropShadow, the whole layer uses the largest Padding per side of all of them.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
