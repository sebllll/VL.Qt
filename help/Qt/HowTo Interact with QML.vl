          <Pad Id="qCPxidbNx1pw3zcj683JOP" Bounds="85,85,647,132" ShowValueBox="true" isIOBox="true" Value="Stepper [Qt] (generated from qml/Stepper.qml)&#xA;- Mouse: press or drag on the bar sets Value, releasing fires Committed&#xA;- Keyboard: a click gives the focus (white frame), Left and Right change Value, Enter commits and releases the focus&#xA;- Value (out) and Committed (out) report back to the patch&#xA;- MouseArea, Keys and focus in the file work as in any Qt Quick scene">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
