          <Pad Id="5ZDf0tJKJ6Th2dGsa983Fn" Bounds="176,311,708,60" ShowValueBox="true" isIOBox="true" Value="Press or drag on the bar sets Value. A click also gives the bar the keyboard focus, a white frame shows it.&#xA;Stepper is generated from qml/Stepper.qml next to this patch.">
