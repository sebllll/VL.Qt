  <Patch Id="VQCJKNDIWLzxVIhGscdb7e">
    <Canvas Id="p0mX7hDlttfAzo8ATtoyM8" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="krkwPsdmD0YmW5pRNibS1p">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="rEBEWSd8ogFSekFqMi0x0m">
        <Canvas Id="aHqIWKBWX9FasGAGZaczw4" CanvasType="Group">
          <Pad Id="aJz0dhmTA4neEkVjV8vn0w" Bounds="85,16,440,52" ShowValueBox="true" isIOBox="true" Value="How To Use Custom Fonts">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="HI59yS5qNZS1XkwznVyZfj" Bounds="85,85,520,78" ShowValueBox="true" isIOBox="true" Value="LoadFont [Qt]&#xD;&#xA;- Path: font file (TTF, OTF, TTC), relative to this patch&#xD;&#xA;- Family: name for the Font Family pin of Text or Style&#xD;&#xA;- A file that cannot be loaded shows at the node">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="e8ijQKVUKFm3eU02pETRT8" Bounds="85,650,830,235" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- LoadFont registers the file for this app only, nothing is installed. LoadFont nodes with the same file share one registration.&#xD;&#xA;- Path is relative to this patch. The folder fonts/ next to the patch is copied next to the executable on export,&#xD;&#xA;  so the same Path works in the exported app. Keep the folder name and the relative Path.&#xD;&#xA;- License: ship only fonts whose license allows it. DejaVu Sans (here) is free (LICENSES/DejaVu-Fonts.txt); many desktop&#xD;&#xA;  fonts (Segoe UI, Arial, Helvetica ...) may not be shipped with an app.&#xD;&#xA;- A missing or unreadable file shows a warning at the node, Family stays empty and the default font is drawn.&#xD;&#xA;  In an exported app that warning is only visible with a logging provider (see HowTo Configure logging providers).&#xD;&#xA;- A family name that is neither installed nor loaded is logged once, Qt then uses a substitute font.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="D7i6kLhEUwLTSKnHgjCRkO" Comment="Path" Bounds="302,241,300,19" ShowValueBox="true" isIOBox="true" Value="fonts/DejaVuSans.ttf">
            <p:TypeAnnotation LastCategoryFullName="IO" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Path" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="300,275,65,19" Id="OgqQsIqXrp1hOxceVkA74X">
            <p:NodeReference LastCategoryFullName="Qt" LastDependency="VL.Qt.dll">
