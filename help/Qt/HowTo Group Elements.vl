          <Pad Id="ACdHNqPnI0UvfUJ31lDv59" Bounds="85,77,830,84" ShowValueBox="true" isIOBox="true" Value="Group [Qt] holds several elements and moves, fades or clips them together:&#xD;&#xA;- Transform, Opacity and Clip of the Group act on all children (Opacity 0 hides them, their input stays).&#xD;&#xA;- Auto Size (default on) makes the Group as big as its children; Size is then ignored; the position comes from Transform (Anchor TopLeft: the origin of the Group is the origin of its children).&#xD;&#xA;- Add inputs with Ctrl+Plus on the node.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
