                <TypeReference LastCategoryFullName="2D" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="Vector2" />
                </TypeReference>
              </p:TypeArguments>
            </p:TypeAnnotation>
            <p:Value>
              <Item>2.4, 1.0</Item>
              <Item>3.8, 2.4</Item>
              <Item>2.4, 3.8</Item>
              <Item>1.0, 2.4</Item>
            </p:Value>
          </Pad>
          <Pad Id="ImT3R60WrtFGOuaCQLDuIE" Comment="In Handle Ends" Bounds="452,503,92,72" ShowValueBox="true" isIOBox="true">
