          <Pad Id="ZyAEazRsUBXeeZ4GpmzbxL" Bounds="85,16,600,52" ShowValueBox="true" isIOBox="true" Value="How To Draw a Bezier Curve with Handles">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl"><Choice Kind="TypeFlag" Name="String" /></p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Zx3PCXV6EQqP1qulnVzTtt" Bounds="85,85,640,103" ShowValueBox="true" isIOBox="true" Value="Bezier (Handles) [Qt.Paths]&#xD;&#xA;- Anchors: the points the curve passes through, one exact cubic per segment&#xD;&#xA;- In Handles, Out Handles: relative to their anchor, a missing handle is a corner; the circles show anchors and handle ends&#xD;&#xA;- Closed: the curve returns from the last anchor to the first&#xD;&#xA;- Handle Modes: Free (both handles as given), Mirrored (In = -Out), Aligned (In points opposite to Out, keeps its own length)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl"><Choice Kind="TypeFlag" Name="String" /></p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Wb0diDKZVMorhFEHwKr71o" Bounds="100,200,400,46" ShowValueBox="true" isIOBox="true" Value="1  Free (default): In and Out are independent, the curve has a kink wherever they do not line up.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl"><Choice Kind="TypeFlag" Name="String" /></p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
