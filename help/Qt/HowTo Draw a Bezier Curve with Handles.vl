      <Patch Id="hPkTswGkpXGhc2h7N9d7UQ">
        <Canvas Id="wDaggOhKVwFLsI5eq8GYlT" CanvasType="Group">
          <Pad Id="FngHAIRAJ1FZs9lPWSDZfK" Bounds="85,16,719,57" ShowValueBox="true" isIOBox="true" Value="How To Draw a Bezier Curve with Handles">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="dkSkEx62w9F7d1Aqdg9JkM" Bounds="85,85,832,99" ShowValueBox="true" isIOBox="true" Value="Bezier (Handles) [Qt.Paths]&#xA;- Anchors: the points the curve passes through, one exact cubic per segment&#xA;- In Handles, Out Handles: relative to their anchor; here the position of the handle end minus the anchor&#xA;- Closed: the curve returns from the last anchor to the first&#xA;- Handle Modes: Free (both handles as given), Mirrored (In = -Out) or Aligned (In opposite to Out, keeps its length)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
