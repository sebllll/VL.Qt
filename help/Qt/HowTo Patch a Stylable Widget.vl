          <Node Name="XYSlider" Bounds="116,310" Id="DJOpauXtCUiP4jHJ36zqOS">
            <p:NodeReference>
              <Choice Kind="ClassDefinition" Name="Class" />
              <FullNameCategoryReference ID="Primitive" />
            </p:NodeReference>
            <p:Interfaces>
              <TypeReference LastCategoryFullName="Qt.Style" LastDependency="VL.Qt.dll">
                <Choice Kind="MutableInterfaceType" Name="IStylable" />
              </TypeReference>
            </p:Interfaces>
            <Patch Id="CksEPHFDjLBLvFmHJeSgmv">
              <Canvas Id="LznzUmtDoRUNS0fRIZnW6l" CanvasType="Group">
                <Pad Id="UCBNiuxmV5FNDqvQR2mC9e" Bounds="60,10,830,125" ShowValueBox="true" isIOBox="true" Value="This class is a self-made widget, an XY slider that implements IStylable (Qt.Style). When a Group, Row or Column shows it, it calls Build with the style resolved down to this position (base style, then every Group on the way).&#xD;&#xA;Build runs every frame. The getters return resolved values, also when no Style is connected (then the base style applies).&#xD;&#xA;Style sizes are px, the scene is in units of 100 px, so Radius, Border Width and Font Size are divided by 100.&#xD;&#xA;The output pin of Build must be named Result (with Output vvvv adds a second, empty Result pin).">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
                  <p:ValueBoxSettings>
                    <p:fontsize p:Type="Int32">9</p:fontsize>
                    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                  </p:ValueBoxSettings>
                </Pad>
