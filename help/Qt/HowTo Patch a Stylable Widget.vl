    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="p839GaOhylDvx2F2QwIbvv">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="rsQWTZqyArbYXMLStbLcl9">
        <Canvas Id="C83gURf6modDXMIGFMIyqg" CanvasType="Group">
          <Pad Id="K2Ph7m9dNvs1XZsVRK3nPG" Bounds="85,16,560,52" ShowValueBox="true" isIOBox="true" Value="How To Patch a Stylable Widget">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="4xhC4rt1ND5Osgq52q74mt" Bounds="85,85,830,200" ShowValueBox="true" isIOBox="true" Value="A self-made widget reads the style of its surroundings by implementing IStylable (Qt.Style). The class XYSlider (see its definition) is built from primitives: a frame, a knob (Circle) and a text showing the value.&#xD;&#xA;- IStylable: connect the widget to a Group, Row or Column like any element. The container calls Build with the style resolved at that position (base style, then every Group on the way) and shows the returned element.&#xD;&#xA;- Build runs every frame, after the patch was updated. Element nodes inside return the same element while nothing changes, so the scene stays untouched.&#xD;&#xA;- The getters (ResolveState, GetColors, GetFrame, GetText) return resolved values, also without a Style: then they come from the base style.&#xD;&#xA;- Bounds, Radius and the value Channel are pins of XYSlider. The Button next to each slider is the built-in one for comparison.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="FKsR01Qzh371EkTIbAUe20" Bounds="85,300,830,85" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;The slider sits in two Groups with different presets (Dark, Light). The Style pin of the Group is all it takes: the slider has no Style pin of its own. Hover and drag it to see the state colors change like the built-in Button.&#xD;&#xA;The left slider is bound to a Channel, the Value IOBox shows the value you drag.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
