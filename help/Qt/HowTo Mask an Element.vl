      </p:NodeReference>
      <Patch Id="oUerTlaqre9cmGdAYJ8xra">
        <Canvas Id="uScPDIsJvSA3VTrzBuIAyj" CanvasType="Group">
          <Pad Id="6nsBvBqJd0ssw0FzvGr3Gw" Bounds="85,16,500,52" ShowValueBox="true" isIOBox="true" Value="How To Mask an Element">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="nPFYhvmuTtiLOfYczUJ4zI" Bounds="85,85,520,94" ShowValueBox="true" isIOBox="true" Value="Mask [Qt.Effects]&#xD;&#xA;- Mask: element used as alpha mask (here a Text), not drawn by itself&#xD;&#xA;- Inverted: show the element where the mask is transparent&#xD;&#xA;- Threshold Min / Max, Spread at Min / Max (optional): soften the edge&#xD;&#xA;- Chains with other effects on the Effect pin">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Kdztgacm06EMXQdYG6INyN" Bounds="85,1091,830,110" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- Mask uses an element as alpha mask for the element it is attached to, e.g. a Text as window onto a Rectangle.&#xD;&#xA;- The mask lies in the coordinates of the parent like a sibling: it masks exactly where it would be drawn as an element in the same Group; moving the masked element leaves the window in place.&#xD;&#xA;- A slow LFO moves the text across the rectangle and shows the window travelling.&#xD;&#xA;- See also: HowTo Chain Effects.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
