            </p:TypeAnnotation>
          </Pad>
          <Pad Id="HdqHhsjGn8Oh1O6gTxF8Is" Comment="Fragment Code" Bounds="422,690,440,200" ShowValueBox="true" isIOBox="true" Value="#version 440&#xD;&#xA;layout(location = 0) in vec2 qt_TexCoord0;&#xD;&#xA;layout(location = 0) out vec4 fragColor;&#xD;&#xA;&#xD;&#xA;layout(std140, binding = 0) uniform buf {&#xD;&#xA;    mat4 qt_Matrix;&#xD;&#xA;    float qt_Opacity;&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;void main()&#xD;&#xA;{&#xD;&#xA;    vec2 uv = qt_TexCoord0;&#xD;&#xA;    // red moves x, green moves y, 0.5 = no shift&#xD;&#xA;    float x = 0.5 + 0.5 * sin(uv.y * 40.0);&#xD;&#xA;    float y = 0.5 + 0.5 * sin(uv.x * 25.0);&#xD;&#xA;    fragColor = vec4(x, y, 0.0, 1.0) * qt_Opacity; // premultiplied&#xD;&#xA;}">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
