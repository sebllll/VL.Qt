      </p:NodeReference>
      <Patch Id="fJEfEDHXmQrOLzhJSH57m2">
        <Canvas Id="nXyI7eUKSgGAfhkFJPvfbB" CanvasType="Group">
          <Pad Id="7xY5wFDel6EixeF8SLTeyl" Bounds="85,16,405,52" ShowValueBox="true" isIOBox="true" Value="How To Displace an Element">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="CdXl2JvMta5xOQlunYx5Z7" Bounds="85,85,830,84" ShowValueBox="true" isIOBox="true" Value="Displace (Qt.Effects) shifts the pixels of an element by a displacement map, which is itself an element:&#xD;&#xA;- Map: any element, here a ShaderEffect. Its red channel moves the pixels in x, green in y, 0.5 = no shift; the alpha of the map scales the shift.&#xD;&#xA;- Displacement: the largest shift in units (a map value of 0 or 1 moves the pixels by this).&#xD;&#xA;- The map is stretched over the element, also behind a Blur (outside the element the edge of the map continues), it is not drawn itself and does not count for layout.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="40mPKGcVkIMbl8iyOzpN2H" Bounds="85,184,830,84" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- Without a Map the chain passes on unchanged.&#xD;&#xA;- Size the map element like the element it displaces, the position does not matter.&#xD;&#xA;- The map can be animated like any element (a ShaderEffect with a Time uniform, a Video, ...).">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
