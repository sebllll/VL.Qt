          <Pad Id="9mkJiwZl0VlnQyW1YyST3r" Comment="Size" Bounds="502,935,35,28" ShowValueBox="true" isIOBox="true" Value="5.2, 2.4">
            <p:TypeAnnotation LastCategoryFullName="2D" LastDependency="VL.CoreLib.vl">
