        <Canvas Id="xS6a9GpzrhBYVc5XDMgG65" CanvasType="Group">
          <Pad Id="i3FSJb2w7vQZXdtbBtS4v8" Bounds="85,16,440,52" ShowValueBox="true" isIOBox="true" Value="How To Take a Snapshot">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="U3SItlSkcI51GxlBNgor02" Bounds="85,85,918,221" ShowValueBox="true" isIOBox="true" Value="Snapshot [Qt] grabs an element (or a Group with its children) as an IImage of vvvv on Grab, e.g. for thumbnails, export or processing in Skia/OpenCV:&#xD;&#xA;- The element has to be shown in a renderer, otherwise Error says so. Here the same Group goes to the Qt Renderer and to Snapshot.&#xD;&#xA;- It is asynchronous: Is Ready comes one frame after Grab (never in the same frame), Image keeps the last finished snapshot until a new one is done.&#xD;&#xA;- Pixel size = size of the element in DIP * Scale, independent of the screen's DPI scaling, so an export is the same on every screen.&#xD;&#xA;- Image is BGRA8 premultiplied and an own copy (not volatile). Here FromImage [Skia] turns it into a Skia image that DrawImage shows in a Skia Renderer.&#xD;&#xA;- It is no frame stream: use it for single images, not for every frame.&#xD;&#xA;- Stable 60 fps: load images in advance or asynchronously, never synchronously while the frame is running.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
