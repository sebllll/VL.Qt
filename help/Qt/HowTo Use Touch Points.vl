            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="J7TGdmQwBZwMio4aWYRxTy" Bounds="85,1391,830,110" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- Hover on touch exists only while a finger is down (a finger does not hover).&#xD;&#xA;- Pressure and Size depend on the device, many touchscreens always report Pressure 0.5 and Size 0 x 0.&#xD;&#xA;- Holding a finger still for a long time can open a right-click on Windows (press and hold, can be switched off in the Windows pen and touch settings), unless QtNative suppresses it.&#xD;&#xA;- With Occlusion on, a finger taken by a Click or Drag element on top is not reported here.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="DClkmKlGzEcOYegDGAVS1S" Bounds="702,342,417,46" ShowValueBox="true" isIOBox="true" Value="Here a ForEach draws one circle per finger with its Id; the circles have no Interaction, so the background still gets the touches.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="UxnafcxcIbzMXCCcC7XQtx" Bounds="393,344,159,93" ShowValueBox="true" isIOBox="true" Value="Devices is TouchScreen and Pen by default; with Mouse added (as here) the mouse counts as one point, so you can try the patch without a touchscreen. ">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">7</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
