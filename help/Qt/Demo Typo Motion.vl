          <Pad Id="u8jzPde0IgxLd6GncfBAep" Bounds="85,16,440,52" ShowValueBox="true" isIOBox="true" Value="Demo Typo Motion">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="fJBd0Kh8oOOL8dKLzdocJ2" Bounds="85,85,900,122" ShowValueBox="true" isIOBox="true" Value="VL.Qt demo Typo Motion:&#xD;&#xA;- 20 text rows (Column) animated by LFOs, rectangle backgrounds, a drop shadow on the Column (Effect pin), clickable box counting clicks.&#xD;&#xA;- Space v1 = DIP top left, 1 unit = 100 DIP.&#xD;&#xA;- Each row: LFO -&gt; CosineWave -&gt; Map -&gt; Group.Opacity and -&gt; Map -&gt; Vector (Join) -&gt; Translate -&gt; Group.Transform (x offset), Rectangle + Text in a Group.&#xD;&#xA;- 20 rows -&gt; Column (Effect: DropShadow) -&gt; Group -&gt; Renderer">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
