      <Patch Id="hTiD9uOP9s4jD03u1yg3VC">
        <Canvas Id="h6BCkBpLVPgaZ89G0VSBPR" CanvasType="Group">
          <Pad Id="GhUcb2hNbLKOIvap6nzu2V" Bounds="85,16,440,52" ShowValueBox="true" isIOBox="true" Value="How To Track the Pointer">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="FzeV1e5wmBhFUsvqFj4UWa" Bounds="85,85,830,103" ShowValueBox="true" isIOBox="true" Value="Point reports where the pointer is on the element, local to the element in units:&#xD;&#xA;- With Buttons None the mouse counts while it hovers the element (no press needed), so the cyan marker follows the mouse.&#xD;&#xA;- With Buttons Left the orange marker only moves while the left button is down and stays at the last position after the release.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="FtJsmxIv8PVSBZvVyxoFAv" Bounds="23,576,178,80" ShowValueBox="true" isIOBox="true" Value="The chain is Point (None) -&gt; Point (Left) -&gt; Interaction pin of the background rectangle; the order does not matter.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">7</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="GMzD55htVFoSMhl3IJzLZf" Bounds="475,1060,300,65" ShowValueBox="true" isIOBox="true" Value="The markers have no Interaction node: they are transparent for input, the background still gets the mouse.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
