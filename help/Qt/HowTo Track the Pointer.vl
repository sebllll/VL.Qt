    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="W4UfdNzuP9roAevfKw7rlf">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
