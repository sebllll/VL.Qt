    <Canvas Id="x6OpjgFR9z18YHoZiSx1m9" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="ao6VK6AFteo4eD3rggo7tn">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="M0YwIqo02k82IHhpib5Jqu">
        <Canvas Id="UUHVz4Fiabk5zi5stU6f7x" CanvasType="Group">
          <Pad Id="5GhZZTH08o7GcUaetrdNHn" Bounds="85,16,380,56" ShowValueBox="true" isIOBox="true" Value="How To Build a Path">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="10bM58Oxx9pJUENQ6e2iMm" Bounds="85,85,700,116" ShowValueBox="true" isIOBox="true" Value="Qt.Paths nodes [Qt] build a path step by step, Path [Qt] draws it:&#xD;&#xA;- Every node takes the path so far at Input and returns the longer path at Output&#xD;&#xA;- MoveTo, LineTo, CubicTo, ArcTo and Close add segments; the (Relative) variants count from the last point&#xD;&#xA;- AddRect, AddRoundRect, AddOval, AddCircle, AddArc, AddPoly and AddPath add whole contours&#xD;&#xA;- ArcTo exists three times, like in Skia: the tangent, oval and SVG form differ in their pins">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="4PwluC4MobMngaY7rGdV5e" Bounds="100,261,290,59" ShowValueBox="true" isIOBox="true" Value="1  A chain of segments: MoveTo, LineTo, LineTo (Relative), CubicTo and Close. Fill and Stroke in the Path node.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="mTYrPfyOpZtWkVB1wbi46d" Bounds="500,261,290,59" ShowValueBox="true" isIOBox="true" Value="2  Two of the three ArcTo forms in one chain: tangent (rounds the corner) and SVG (a half circle).">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="FAZjzSPidfB4hJiA8HsL6w" Bounds="900,261,290,59" ShowValueBox="true" isIOBox="true" Value="3  AddRoundRect adds a whole contour. The unconnected Input starts a new path.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
