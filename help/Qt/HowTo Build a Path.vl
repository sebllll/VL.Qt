          <Pad Id="uLx1708qxSmaaIUloplfJj" Bounds="85,16,300,52" ShowValueBox="true" isIOBox="true" Value="How To Build a Path">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl"><Choice Kind="TypeFlag" Name="String" /></p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="xSMwvxRvZNipHJmmW8wHzI" Bounds="85,85,600,173" ShowValueBox="true" isIOBox="true" Value="Qt.Paths nodes [Qt] build a path step by step, Path [Qt] draws it:&#xD;&#xA;- Every node takes the path so far at Input (unconnected = empty path) and returns the longer path at Output&#xD;&#xA;- MoveTo, LineTo, QuadTo, CubicTo, ArcTo and Close add segments; the (Relative) variants count from the last point&#xD;&#xA;- AddRect, AddRoundRect, AddOval, AddCircle, AddArc, AddPoly and AddPath add whole contours&#xD;&#xA;- ArcTo exists three times, like in Skia: the tangent, oval and SVG form differ in their pins">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl"><Choice Kind="TypeFlag" Name="String" /></p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="q6Be8jnpsnDXATgtHZApBP" Bounds="100,318,290,65" ShowValueBox="true" isIOBox="true" Value="1  A chain with a relative point: LineTo (Relative) gets the dragged point minus the previous point (Subtract).">
