          <Pad Id="5E3KMYGJtOpZukOpTvolty" Bounds="85,85,520,94" ShowValueBox="true" isIOBox="true" Value="Wheel [Qt]&#xD;&#xA;- Counts the mouse wheel over the element in notches (trackpads give fractions)&#xD;&#xA;- Value: accumulated channel, Wheel adds the motion to it&#xD;&#xA;- Delta: motion of the last frame&#xD;&#xA;- Chain: Wheel -&gt; Interaction pin of the rectangle">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="sRzL8ru8AbmPkcb21WWGHa" Bounds="229,1136,830,62" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- Without an Interaction node an element is transparent for input. Scroll over the rectangle.&#xD;&#xA;- The order of the chain does not matter.">
