          <Pad Id="wtvdxmdjkxBs5VwBVtpimu" Bounds="85,85,520,78" ShowValueBox="true" isIOBox="true" Value="Button [Qt]&#xD;&#xA;- Bang: true for one frame per click (here counted)&#xD;&#xA;- Is Clicked: channel pin, a Reactive Channel of Unit (shows as a bang)&#xD;&#xA;- Enabled, Auto Repeat, Auto Size">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="dGla7uN4vRQZihlDnDYwBp" Bounds="85,1089,830,78" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- A click is reported when the mouse is released over the button (like Qt clicked).&#xD;&#xA;- Enabled = false greys the button out and blocks clicks. Auto Repeat repeats the click while the button is held down.&#xD;&#xA;- Auto Size takes the size from the text: Size is ignored while it is on, the position comes from Transform and Anchor.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
