          <Pad Id="jD2xZWlQBIfTnncaWoj0Oe" Bounds="122,462,340,38" ShowValueBox="true" isIOBox="true" Value="Fragment Code: one String pad for both passes (same text as shaders/blur_mask.frag).">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">7</p:fontsize>
