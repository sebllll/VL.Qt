          <Pad Id="TmEKT2nNt93jJe5s6RYMnq" Bounds="85,85,640,103" ShowValueBox="true" isIOBox="true" Value="Spline (CatmullRom), Spline (BSpline) [Qt.Paths]&#xD;&#xA;- CatmullRom: a smooth curve through all Points; Alpha sets how it treats uneven spacing (0 uniform, 0.5 centripetal, 1 chordal)&#xD;&#xA;- BSpline: Points are the control polygon, the curve follows it without touching it&#xD;&#xA;- Both add exact cubics to a QtPath, drawn here with Path; the thin gray Polyline is the polygon through the same Points&#xD;&#xA;- Closed joins the end to the start (Tension: Catmull-Rom only, 1 = straight lines)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl"><Choice Kind="TypeFlag" Name="String" /></p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="zkmn4eesdqsmfFEVtwscUO" Bounds="100,215,320,46" ShowValueBox="true" isIOBox="true" Value="1  Alpha 0: uniform. The curve overshoots and loops where points are unevenly spaced.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl"><Choice Kind="TypeFlag" Name="String" /></p:TypeAnnotation>
            <p:ValueBoxSettings>
