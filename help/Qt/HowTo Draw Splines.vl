        <Canvas Id="ViREDxUdxMG5w4ZiWREk9F" CanvasType="Group">
          <Pad Id="m0GOJjQGpQGP2qZ8IRVgFF" Bounds="85,16,330,52" ShowValueBox="true" isIOBox="true" Value="How To Draw Splines">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="0TFLcjxZOvFbybUPo3G21Q" Bounds="85,85,916,99" ShowValueBox="true" isIOBox="true" Value="Spline (CatmullRom), Spline (BSpline) [Qt.Paths]&#xA;- CatmullRom: a smooth curve through all Points; Alpha sets how it treats uneven spacing (0 uniform, 0.5 centripetal, 1 chordal)&#xA;- BSpline: Points are the control polygon, the curve follows it without touching it&#xA;- Both add exact cubics to a QtPath, drawn here with Path; the thin gray Polyline is the polygon through the same Points&#xA;- Closed joins the end to the start (Tension: Catmull-Rom only, 1 = straight lines)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="11POhypMyyFGXbYME273lH" Comment="Radius" Bounds="102,217,35,15" ShowValueBox="true" isIOBox="true" Value="0.2">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float32" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="mwV9pDafYVGoq3LxMvxQFU" Comment="Translation" Bounds="182,245,92,111" ShowValueBox="true" isIOBox="true">
            <p:TypeAnnotation LastCategoryFullName="Collections" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Spread" />
              <p:TypeArguments>
                <TypeReference LastCategoryFullName="2D" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="Vector2" />
                </TypeReference>
              </p:TypeArguments>
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:maxvisibleentries p:Type="Int32">6</p:maxvisibleentries>
            </p:ValueBoxSettings>
            <p:Value>
              <Item>0.5, 2.6</Item>
              <Item>1.1, 1.1</Item>
              <Item>1.6, 1.0</Item>
              <Item>3.4, 2.0</Item>
              <Item>3.7, 3.0</Item>
              <Item>5.2, 1.4</Item>
            </p:Value>
          </Pad>
          <Pad Id="eKfReW4VVmGcELxT8lQXED" Bounds="420,235,335,118" ShowValueBox="true" isIOBox="true" Value="Curves on the same Points:&#xA;- red: Spline (CatmullRom), Alpha 0 (uniform)&#xA;- green: Alpha 0.5 (centripetal)&#xA;- blue: Alpha 1 (chordal)&#xA;- yellow: Spline (BSpline)&#xA;- gray: control polygon (Polyline)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
