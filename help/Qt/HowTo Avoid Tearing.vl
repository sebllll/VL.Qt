          <Pad Id="nTfEQKLtO4wZCK40tqFrxe" Bounds="85,16,440,52" ShowValueBox="true" isIOBox="true" Value="How To Avoid Tearing">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="IUjcRO82yxDZgiIXHldReb" Bounds="85,85,830,103" ShowValueBox="true" isIOBox="true" Value="Renderer [Qt], pin VSync&#xD;&#xA;- true: Present waits for the display refresh, no tearing&#xD;&#xA;- false: Present never blocks, tearing is possible&#xD;&#xA;- Applies when the window is created: a change recreates the window&#xD;&#xA;- Known state: with several VSync windows the frame rate drops to about refresh / number of windows">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
