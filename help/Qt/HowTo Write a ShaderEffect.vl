          <Pad Id="HRZKuqfacG0Mow0ooRfhtG" Bounds="1140,288,480,46" ShowValueBox="true" isIOBox="true" Value="3  Write the GLSL in the patch: Fragment Code comes from a String pad, an LFO animates the time uniform. Edit the text while the patch runs.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="KhHisq8X7Wh0VYDW3BA1bg" Comment="Fragment Code" Bounds="1162,385,440,200" ShowValueBox="true" isIOBox="true" Value="#version 440&#xD;&#xA;layout(location = 0) in vec2 qt_TexCoord0;&#xD;&#xA;layout(location = 0) out vec4 fragColor;&#xD;&#xA;&#xD;&#xA;layout(std140, binding = 0) uniform buf {&#xD;&#xA;    mat4 qt_Matrix;&#xD;&#xA;    float qt_Opacity;&#xD;&#xA;    float time; // from the Float uniform named time&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;void main()&#xD;&#xA;{&#xD;&#xA;    vec2 uv = qt_TexCoord0;&#xD;&#xA;    // wavy stripes moving to the right&#xD;&#xA;    float s = 0.5 + 0.5 * sin((uv.x + 0.15 * sin(uv.y * 6.0)) * 24.0 - time * 4.0);&#xD;&#xA;    vec3 rgb = mix(vec3(0.05, 0.1, 0.4), vec3(1.0, 0.5, 0.1), s);&#xD;&#xA;    fragColor = vec4(rgb, 1.0) * qt_Opacity; // premultiplied&#xD;&#xA;}">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
