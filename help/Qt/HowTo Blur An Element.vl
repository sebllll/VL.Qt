    <Node Name="Application" Bounds="100,180" Id="FV9ermFXqVCztt7fwUBIfV">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="z70IFauOzWOln4Mp6HsV3k">
        <Canvas Id="H9LDrQLs1Ekcpx6IDvotur" CanvasType="Group">
          <Pad Id="QHkGdd5MWoJ49uCWZ4Jc1I" Bounds="85,16,505,52" ShowValueBox="true" isIOBox="true" Value="How To Blur an Element">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="uvkqdtgHiOUtjHX2ZaXMrt" Bounds="85,85,520,94" ShowValueBox="true" isIOBox="true" Value="DirectionalBlur, ZoomBlur, RadialBlur [Qt.Effects]&#xD;&#xA;- DirectionalBlur: Angle (cycles, 0 = horizontal, clockwise), Length&#xD;&#xA;- ZoomBlur: Center (0..1 of the element area), Length&#xD;&#xA;- RadialBlur: Center, Angle (total rotation in cycles), Padding (optional)&#xD;&#xA;- Attach to the Effect pin">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="ySq2JcV5oo8EyQUkt1Msgk" Bounds="85,809,834,194" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- The blurs smear the element like a long exposure. The picture does not shift: the blur is centred on every pixel. Two passes keep long blurs clean.&#xD;&#xA;- Length is in DIP. ZoomBlur streaks along rays from Center, growing from nothing at Center to Length at the farthest corner. RadialBlur draws arcs around Center.&#xD;&#xA;- The effect area grows with the blur. RadialBlur cannot know how far the farthest point is from Center: give it room with Padding if the arcs are cut.&#xD;&#xA;- For a motion look, animate Length or Angle (for example with an LFO) and watch the Perf overlay of the Renderer: the blurs run at 60 fps on a Text in 1080p.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
