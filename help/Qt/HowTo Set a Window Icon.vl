  <Patch Id="dD28xudZ8uDWzoOIiRe2As">
    <Canvas Id="a4gg3i8949lrAVE31UDtlt" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="Qp6j8s13DImd91oD73v2EZ">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="AHtL1yw5RpOwe0KcRqPjqA">
        <Canvas Id="XKqD2Dqon1N3xCQW7hOSvq" CanvasType="Group">
          <Pad Id="LjbD46E7vddepGibPoG4m4" Bounds="85,16,440,52" ShowValueBox="true" isIOBox="true" Value="How To Set a Window Icon">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="DwtJfBV7tnlOHZdOUSILaq" Bounds="85,85,520,78" ShowValueBox="true" isIOBox="true" Value="Window Settings [Qt]: icon of the Renderer window (title bar, taskbar, Alt-Tab)&#xD;&#xA;- Output to the Window pin of Renderer [Qt]&#xD;&#xA;- Icon: .ico, .png, .svg or anything Qt reads, relative to this patch&#xD;&#xA;- Bounds: optional, initial position and size, wins over the Bounds pin of Renderer [Qt] (Title, Borderless and Fullscreen are pins of Renderer [Qt])">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="luRThQEyxFfVIYOjcxmKcE" Bounds="85,465,830,173" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- Without Window Settings the window shows the built-in default icon; no value (or an empty path) shows it again. Changes apply live, without recreating the window.&#xD;&#xA;- A file that cannot be loaded keeps the default icon and shows a warning at Renderer [Qt].&#xD;&#xA;- Bounds in Window Settings only apply when the window is created; Save Bounds and Client Bounds stay on Renderer [Qt].&#xD;&#xA;- Exported apps: the default icon is built in and needs no file next to the exe. The icon of the .exe file itself is set in the vvvv export settings.&#xD;&#xA;- Linux (Wayland): the compositor takes the icon from the app id and the .desktop file, not from the window.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="YKQ6Jo2uBVY2X1yPolktMP" Comment="Icon" Bounds="262,250,300,19" ShowValueBox="true" isIOBox="true" Value="assets/qt-help-window-icon.png">
            <p:TypeAnnotation LastCategoryFullName="IO" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Path" />
            </p:TypeAnnotation>
          </Pad>
