      <Patch Id="gmZsurwQgeeyCHKE0z2A7v">
        <Canvas Id="jJoXqzAJNzhrWcZzM2whyu" CanvasType="Group">
          <Pad Id="53Uby2K0OPoT9l4oiD6igO" Bounds="85,16,436,52" ShowValueBox="true" isIOBox="true" Value="How To Reuse an Element">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="yZVkqeCH20DeJxWsbwD7R1" Bounds="85,85,520,78" ShowValueBox="true" isIOBox="true" Value="Reuse an Element: one element at several places of the tree&#xD;&#xA;- Output of one element to several Groups (or Row, Column)&#xD;&#xA;- Each place is drawn at the position of its parent&#xD;&#xA;- Interaction on the Group around each place (here Hover) tells the places apart">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="8YuIf5hCSkjKX9fEhb8qzb" Bounds="91,1023,830,115" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- State outputs (Measured Size, Scene Bounds) and the error come from the first place, events (e.g. Click of a Button) from every place.&#xD;&#xA;- An Interaction directly at the reused element works at the first place only (warning).&#xD;&#xA;- Video: only the first place plays, the others stay empty (warning at the node).&#xD;&#xA;- An element in more than one Renderer is only shown by the first Renderer (warning).">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
