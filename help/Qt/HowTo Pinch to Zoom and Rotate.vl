  <Patch Id="mqGSDSmBZ5XgzbtJHNaTdA">
    <Canvas Id="WXVXVYiRCNhunrKcBkStoW" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="k8jzXWec4Jhw1nInX5uYxi">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="E5xhZs2pEui7MK26HJqFDy">
        <Canvas Id="nUJjL2oXjWCGiqRjNtiazz" CanvasType="Group">
          <Pad Id="F53UjEm8dcGIBTYbyXlVab" Bounds="85,16,658,52" ShowValueBox="true" isIOBox="true" Value="How To Pinch to Zoom and Rotate">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="FwHJ1yB0m6HUP91oS6gFXK" Bounds="85,85,520,94" ShowValueBox="true" isIOBox="true" Value="Pinch [Qt]: two-finger gesture on the element&#xD;&#xA;- Scale: factor, 1 at the start (2 = fingers twice as far apart)&#xD;&#xA;- Rotation: in cycles (1 = 360 degrees), clockwise positive&#xD;&#xA;- Translation: movement of the fingers' centre in units&#xD;&#xA;- Is Pinching: true while the gesture runs">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="GaBfqkcwk3KNjEEXTtTxAo" Bounds="85,1428,830,110" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- All values are counted from the start of the gesture.&#xD;&#xA;- Pinch only reports, it moves nothing: the patch applies the values itself. The channels keep their last value after the gesture, which is why the live values are only used while Is Pinching is true.&#xD;&#xA;- When Is Pinching falls (TogEdge, Down Edge) the S+H stores the result, so the image stays where the fingers left it and the next gesture continues from there (FrameDelay closes the loop).">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="GkYCvKLfhXeQR1vDZQX03q" Bounds="482,778,460,46" ShowValueBox="true" isIOBox="true" Value="Transform of the image = committed transform combined with the live values while Is Pinching is true">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="F4xQhSFI0ubI8UtntMxE45" Bounds="290,979,415,19" ShowValueBox="true" isIOBox="true" Value="The image is scaled and rotated around its centre (Anchor).">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
