  <Patch Id="bQTyzpl3Qjy4mpEo0t6ssu">
    <Canvas Id="mIfOGEpRsVAgcfxxwvaA7q" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,180" Id="NinlvUvIkgB0VA8ECRsWmJ">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="t2fpFcUB804BasC9zX4wtC">
        <Canvas Id="2UL1hsXREtHo0SxQPLShfk" CanvasType="Group">
          <Pad Id="8xkOM3FCHlQ14GZ3Cs0Eez" Bounds="85,16,420,52" ShowValueBox="true" isIOBox="true" Value="How To Combine Effects">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="exz6hot9iOB4MtfjoQIH55" Bounds="85,85,830,122" ShowValueBox="true" isIOBox="true" Value="Blur, DropShadow, ColorAdjust, Colorize and Mask are the MultiEffect nodes (category Qt.Effects.MultiEffect). Neighbouring ones in a chain are folded into ONE Qt MultiEffect: one layer, one shader.&#xD;&#xA;- Inside such a run Qt's fixed order applies, the order of the nodes does not matter.&#xD;&#xA;- A shader node (category Qt.Effects, e.g. RGBSplit or Glow) ends the run and costs at least one offscreen layer of its own. Between the runs the data flow order applies.&#xD;&#xA;- Left: Blur -&gt; DropShadow, one layer. Right: the same two nodes with a shader in between, three layers.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="sNc4aJxBzBsrhfl7kCKedZ" Bounds="85,222,830,160" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- The cost is the number of layers: each one is an offscreen texture plus a render pass. Keep MultiEffect nodes together, and where the look allows it put shader nodes at the start or the end of a chain.&#xD;&#xA;- The order across a shader changes the picture (Blur before or after the shader): see HowTo Chain Shader Effects.&#xD;&#xA;- Padding of Blur and DropShadow, ColorAdjust and Colorize: see HowTo Chain Effects.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="c9pAMzodTwXQofqnmh1dwD" Bounds="100,440,450,46" ShowValueBox="true" isIOBox="true" Value="1  Blur -&gt; DropShadow: one MultiEffect, one layer.">
