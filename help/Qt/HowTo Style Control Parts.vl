      <Patch Id="0eMD2Q4XLcm5aMIAUJrbeZ">
        <Canvas Id="a1lfSpalolq5TYpbbhf7fm" CanvasType="Group">
          <Pad Id="u8jzPde0IgxLd6GncfBAep" Bounds="85,16,440,52" ShowValueBox="true" isIOBox="true" Value="How To Style Control Parts">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="fJBd0Kh8oOOL8dKLzdocJ2" Bounds="85,85,520,94" ShowValueBox="true" isIOBox="true" Value="Control parts of a Style, shown at Slider and Toggle&#xD;&#xA;- Indicator: Slider handle, Switch knob, Checkbox check mark&#xD;&#xA;- Track: Slider groove, Switch lane; Track Fill is its filled part&#xD;&#xA;- Colors: colors of these parts; Indicator, Track: size and radius&#xD;&#xA;- Not per control type: separate Groups, or Style at the widget">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="isAjIhKtJ0RlgLKOmxgJTe" Bounds="85,1227,830,110" ShowValueBox="true" isIOBox="true" Value="Notes:&#xD;&#xA;- Track Fill is the value of a Slider, or the on-state of a Switch.&#xD;&#xA;- There is no Style per control type: to style Sliders and Toggles differently, put them in separate Groups (or set Style at the widget).&#xD;&#xA;- Merge (Qt.Style) lays Input 2 over Input field by field and state by state, so a preset can be the base for a few overrides.&#xD;&#xA;- The outer Group has no Style of its own; each inner Group brings its own.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
