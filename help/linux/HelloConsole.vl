    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="Zrc9Bs44z9ODwzOytwuE7K">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="T3muvONPX2OEEgI9PdXzFm">
        <Canvas Id="Rb2grtW50RnDlBtxbU6vyp" CanvasType="Group">
          <Pad Id="Jj8beR2Ra4gDVPWw85Vj44" Bounds="100,203,520,45" ShowValueBox="true" isIOBox="true" Value="Linux spike L0a (no VL.Qt): FrameCounter -&gt; WriteLine [System.Console]. KeepAppAlive [System] in the top-level patch keeps the exported console app running; without it the app ends after the first frame.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">14</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="PHQ6EmnYyOGYHA728YVJ2e" Comment="Count" Bounds="102,283,35,35" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Toggle</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="100,343,81,19" Id="Ojta0PMzp9tPPm3adwpmQN">
            <p:NodeReference LastCategoryFullName="Animation.FrameBased" LastDependency="CoreLibBasics.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="FrameCounter" />
            </p:NodeReference>
            <Pin Id="KzfeFcLNehsd5FSG4oLnHH" Name="Count" Kind="ApplyPin" />
            <Pin Id="IRwB1s8moDe0UQEwz1iMkA" Name="Reset" Kind="ApplyPin" />
            <Pin Id="Hb4ucAVweS4rQ7dapMTLpe" Name="Value" Kind="OutputPin" />
          </Node>
          <Pad Id="KdYn3eB3A2XpmsCXcdsot8" Comment="Apply" Bounds="142,383,35,35" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Toggle</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="100,443,58,19" Id="IzJZaPKGfaADLemRlDNIWg">
            <p:NodeReference LastCategoryFullName="System.Console" LastDependency="VL.CoreLib.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="WriteLine" />
            </p:NodeReference>
            <Pin Id="CDFrPN8jK5Q2nahIOjWX7r" Name="Value" Kind="InputPin" />
            <Pin Id="YnId7yJ7yIcmH2NLxEo1Wd" Name="Apply" Kind="InputPin" />
          </Node>
          <Pad Id="S2W8hDAqeki2XqI5okdPN6" Comment="Is Alive" Bounds="402,383,35,35" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Toggle</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="400,443,85,19" Id="C68m7vle8GAsFlLvfFgdVq">
            <p:NodeReference LastCategoryFullName="System" LastDependency="CoreLibBasics.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <CategoryReference Kind="Category" Name="System" NeedsToBeDirectParent="true" />
              <Choice Kind="ProcessAppFlag" Name="KeepAppAlive" />
            </p:NodeReference>
            <Pin Id="OVzLLJAs5tDGuT0C1FCGnL" Name="Is Alive" Kind="InputPin" />
          </Node>
          <Pad Id="RBd42D1PCLZEh93yHqxaJM" Bounds="85,16,440,52" ShowValueBox="true" isIOBox="true" Value="Hello Console">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="KcUaPl9caRsisk9QJ0ImK5" Bounds="85,85,520,78" ShowValueBox="true" isIOBox="true" Value="Minimal Linux console patch without VL.Qt&#xD;&#xA;- FrameCounter writes its Value to the console with WriteLine&#xD;&#xA;- KeepAppAlive keeps the app running&#xD;&#xA;- Settings in HelloConsole.props, see docs/linux.md">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
