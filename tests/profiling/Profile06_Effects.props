<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VLIgnoreCompileErrors>False</VLIgnoreCompileErrors>
    <VLIgnoreUnhandledExceptions>False</VLIgnoreUnhandledExceptions>
  </PropertyGroup>
  <!-- vvvvc does not copy Path assets: ship tests/profiling/assets next to the exe (paths in the patch are assets/...) -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets\**\*" Link="assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
