</Pad>
<Pad Id="37KeCeu9WHuFd9JZHg1zCk" Bounds="100,70,840,100" ShowValueBox="true" isIOBox="true" Value="What to check: many QtTexture nodes render independently, and a node whose output is not drawn costs nothing.&#xD;&#xA;- Count = 10: ten orange squares in a row, each rotating at its own speed (one QtTexture per square, all composed in the window).&#xD;&#xA;- Set Count to 2: two squares, no ghosts or flicker, no error. Back to 10 and again: nodes are created and disposed cleanly.&#xD;&#xA;- The grey node at the bottom renders a 3840 x 2160 texture that nobody draws: the frame time must not change with it (compare with Enabled off).&#xD;&#xA;- Watch Task Manager (GPU memory, handles) while changing Count several times: no growth. Error pads stay empty.">
  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
    <Choice Kind="TypeFlag" Name="String" />
  </p:TypeAnnotation>
  <p:ValueBoxSettings>
    <p:fontsize p:Type="Int32">9</p:fontsize>
    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
  </p:ValueBoxSettings>
</Pad>
<Pad Id="RIxjFJfGDNnKzIqT0x3zcB" Comment="Count" Bounds="102,200,35,15" ShowValueBox="true" isIOBox="true" Value="10">
  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
    <Choice Kind="TypeFlag" Name="Integer32" />
