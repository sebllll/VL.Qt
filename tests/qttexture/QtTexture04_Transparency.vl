<Pad Id="37KeCeu9WHuFd9JZHg1zCk" Bounds="100,70,840,80" ShowValueBox="true" isIOBox="true" Value="What to check: half-transparent Qt elements over a Stride scene (colored background, torus) look like in a Qt window.&#xD;&#xA;- Stride window: no dark or light fringes at the edges of the squares and the text (Stride blend: AlphaBlend, the texture is premultiplied).&#xD;&#xA;- Compare the colors with the Qt window (same scene, same background color): equal with B8G8R8A8_UNorm_SRgb (default), with R8G8B8A8_UNorm, and with R16G16B16A16_Float.&#xD;&#xA;- Switch Format while running: the texture is recreated, no flash, no error. Where the Stride window and the Qt window differ, note the format.">
  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
    <Choice Kind="TypeFlag" Name="String" />
  </p:TypeAnnotation>
  <p:ValueBoxSettings>
    <p:fontsize p:Type="Int32">9</p:fontsize>
    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
  </p:ValueBoxSettings>
</Pad>
