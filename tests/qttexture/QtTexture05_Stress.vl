  </p:ValueBoxSettings>
</Pad>
<Pad Id="37KeCeu9WHuFd9JZHg1zCk" Bounds="100,70,840,100" ShowValueBox="true" isIOBox="true" Value="What to check: long run with a changing Size and a switchable Format, no growth and no exceptions.&#xD;&#xA;- Size follows an LFO (period 120 s, 1 x 1 up to 1600 x 900), the Qt scene is always redrawn. Let it run for several minutes.&#xD;&#xA;- Toggle switches the Format between B8G8R8A8_UNorm_SRgb and R16G16B16A16_Float: toggle it several times, also while Size changes.&#xD;&#xA;- Task Manager / GPU memory and handle count of vvvv stay flat (no staircase growth per resize or format change). Error stays empty.&#xD;&#xA;- Also try: delete the QtTexture node and undo, close the document while it runs: no exception, no hang.">
  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
    <Choice Kind="TypeFlag" Name="String" />
  </p:TypeAnnotation>
  <p:ValueBoxSettings>
    <p:fontsize p:Type="Int32">9</p:fontsize>
    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
  </p:ValueBoxSettings>
</Pad>
