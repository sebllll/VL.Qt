  </p:ValueBoxSettings>
</Pad>
<Pad Id="37KeCeu9WHuFd9JZHg1zCk" Bounds="100,70,840,80" ShowValueBox="true" isIOBox="true" Value="What to check: the number in the Qt texture (top half, yellow-red) and the number drawn directly by Stride (bottom half, black) come from the same FrameCounter.&#xD;&#xA;- Take a screenshot while it runs (Win+Shift+S) or film the window: in every frame both numbers must be identical.&#xD;&#xA;- Expected: same frame, equal numbers. A texture that lags one frame shows the previous number (differs by 1).&#xD;&#xA;- The Error pad stays empty. Hide or move the window: the numbers keep matching.">
  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
    <Choice Kind="TypeFlag" Name="String" />
  </p:TypeAnnotation>
  <p:ValueBoxSettings>
    <p:fontsize p:Type="Int32">9</p:fontsize>
    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
  </p:ValueBoxSettings>
</Pad>
