root = true

# Line endings are normalized by .gitattributes. BOM rule follows VL.StandardLibs:
# .cs and .vl with UTF-8 BOM, everything else without.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{cs,vl}]
charset = utf-8-bom

[*.vl]
end_of_line = crlf

[*.cs]
indent_style = space
indent_size = 4

# Every member spells out its access modifier (interface members stay without).
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
