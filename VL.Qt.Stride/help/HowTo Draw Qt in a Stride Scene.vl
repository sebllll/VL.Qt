            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">25</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Pod9eJjHmcJPYP6RvZ16I8" Bounds="85,85,640,103" ShowValueBox="true" isIOBox="true" Value="QtRenderer [Stride] draws Qt elements as a layer over a 3D scene:&#xD;&#xA;- Content here: half-transparent Rectangles, a Text, a Button and a Slider&#xD;&#xA;- Output into RenderEntity (AfterScene): drawn after the scene, at the size of the viewport&#xD;&#xA;- Blends like a Qt window: gamma space, half-transparent parts included&#xD;&#xA;- Mouse, touch and keyboard of the window reach Button and Slider">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
