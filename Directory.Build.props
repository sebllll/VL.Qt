<Project>
  <PropertyGroup>
    <!-- Compile-time vvvv version (NuGet VL.Core from the vvvv feed). A vvvv update changes only this line
         (plus the three versions below if vvvv ships newer ones). -->
    <VvvvVersion>2026.8.0-0156-g7259116c8c</VvvvVersion>
    <StrideMathematicsVersion>4.3.0.2507</StrideMathematicsVersion>
    <SystemReactiveVersion>6.1.0</SystemReactiveVersion>
    <LoggingAbstractionsVersion>10.0.10</LoggingAbstractionsVersion>
    <!-- VL.Audio from nuget.org (net8.0-windows7.0 build, usable from net10); used by VL.Qt.Audio and its tests. -->
    <VlAudioVersion>1.9.21</VlAudioVersion>
    <!-- Package version of VL.Qt and VL.Qt.Stride: they ship in lockstep (CI overrides it with -p:Version). -->
    <VersionPrefix>0.10.1</VersionPrefix>
  </PropertyGroup>
</Project>
