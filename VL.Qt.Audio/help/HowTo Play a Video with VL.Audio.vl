          <Pad Id="yCPy2w9f1PUgoPp4dOIupq" Bounds="85,85,640,122" ShowValueBox="true" isIOBox="true" Value="Video (VL.Audio) [Qt.Elements]&#xD;&#xA;- Plays a video; its sound comes out as VL.Audio signals at Audio&#xD;&#xA;- Audio goes to AudioOut like any other audio source, Meter shows its level (mono mix)&#xD;&#xA;- Volume (0..1) acts on the signal&#xD;&#xA;- Sync Error (ms) shows how far the sound is off the picture&#xD;&#xA;- Audio Offset (ms) calibrates it, see Notes">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
